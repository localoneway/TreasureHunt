DATABASE_URL="postgresql://user:password@localhost:5432/treasurehunt"

# eBay Browse API (https://developer.ebay.com/) — required for live eBay search/aggregation.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""

# Reddit OAuth app (https://www.reddit.com/prefs/apps, type "script") — required for
# r/Watchexchange search. Reddit blocks unauthenticated/cloud-hosted requests, so a
# real app token is needed even for read-only public data.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# Shared secret required as a Bearer token / ?secret= query param to call /api/cron/poll
CRON_SECRET=""

# Email alerts on new watchlist matches (https://resend.com/) — optional, all three required to enable.
RESEND_API_KEY=""
ALERT_EMAIL_FROM=""
ALERT_EMAIL_TO=""
